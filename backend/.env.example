
# RECON X - Local Development Configuration

# Application
APP_NAME=RECON X API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Runtime
ENVIRONMENT=development
DEBUG=false

# Application secret
SECRET_KEY=replace-with-a-local-development-placeholder

# Logging and CORS
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-generated-local-jwt-secret
JWT_ISSUER=recon-x-local
JWT_AUDIENCE=recon-x-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# MongoDB
MONGODB_URI=replace-with-your-mongodb-atlas-connection-string
MONGODB_DATABASE=RECON_X_DEV
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20

# Upload security
MAX_UPLOAD_BYTES=10485760
PRIVATE_UPLOAD_STORAGE_PATH=private_uploads
UPLOAD_STORAGE_BUCKET=recon-x-private-dev

# Object storage
# Use local for filesystem fallback or s3 for S3-compatible storage
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=recon-x-private-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-local-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-storage-secret
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
